# ============================================================================
# .env.test — CẤU HÌNH MÔI TRƯỜNG TEST / CI
# ============================================================================
# - Kích hoạt khi: NODE_ENV=test
# - Lưu ý: trong profile test, dotenv-flow BỎ QUA file .env.local để đảm bảo
#   kết quả kiểm thử có tính lặp lại (reproducible) trên mọi máy tester và CI.
# ============================================================================

CRM_BASE_URL=https://crm.anhtester.com
CRM_ENV_NAME=test
CRM_TIMEOUT_MS=20000
